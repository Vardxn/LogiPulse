# ==========================================
# STAGE 1: Build Engine
# ==========================================
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package*.json ./
COPY client/package*.json ./client/

RUN npm ci

COPY client ./client

# Next.js telemetry disable during production multi-stage image construction
ENV NEXT_TELEMETRY_DISABLED=1

# Compile and construct standalone output profiles
RUN npm run build --workspace=client

# ==========================================
# STAGE 2: Production Runtime Layer
# ==========================================
FROM node:20-alpine AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy optimized standalone configuration structures generated by Next build pipeline
COPY --from=builder --chown=nextjs:nodejs /app/client/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/client/.next/static ./client/.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Target Next.js standalone execution node handler mapping
CMD ["node", "client/server.js"]
