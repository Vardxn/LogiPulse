datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  WAREHOUSE_OPERATOR
  LOGISTICS_PARTNER
  ADMIN
}

enum TransportMode {
  SEA
  RAIL
  ROAD
}

enum OrderStatus {
  PENDING
  IN_TRANSIT
  DELAYED
  DELIVERED
  CANCELLED
}

enum ExtractionConfidence {
  HIGH
  MEDIUM
  LOW
  FAILED
}

model Tenant {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime    @default(now())
  users     User[]
  warehouses Warehouse[]
  vendors   Vendor[]
  orders    Order[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Warehouse {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  latitude          Decimal         @db.Decimal(9, 6)
  longitude         Decimal         @db.Decimal(9, 6)
  capacityUnits     Int
  inventoryItems    InventoryItem[]
  originOrders      Order[]         @relation("OriginOrders")
  destinationOrders Order[]         @relation("DestinationOrders")
}

model Vendor {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  contactEmail      String
  tariffDefaultCode String?
  orders            Order[]
}

model InventoryItem {
  id               String      @id @default(uuid()) @db.Uuid
  warehouseId      String      @db.Uuid
  warehouse        Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sku              String
  name             String
  quantity         Int
  reorderThreshold Int
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]

  @@index([warehouseId])
  @@index([sku])
}

model Order {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @db.Uuid
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId               String               @db.Uuid
  vendor                 Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  originWarehouseId      String               @db.Uuid
  originWarehouse        Warehouse            @relation("OriginOrders", fields: [originWarehouseId], references: [id], onDelete: Cascade)
  destinationWarehouseId String               @db.Uuid
  destinationWarehouse   Warehouse            @relation("DestinationOrders", fields: [destinationWarehouseId], references: [id], onDelete: Cascade)
  status                 OrderStatus
  totalCost              Decimal              @db.Decimal(12, 2)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  orderItems             OrderItem[]
  shipmentRoute          ShipmentRoute?
  billOfLadingRecords    BillOfLadingRecord[]

  @@index([status])
  @@index([tenantId, status])
}

model OrderItem {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @db.Uuid
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String        @db.Uuid
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int
}

model ShipmentRoute {
  id                    String   @id @default(uuid()) @db.Uuid
  orderId               String   @unique @db.Uuid
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  path                  Json
  totalDistanceKm       Decimal  @db.Decimal(10, 2)
  totalCost             Decimal  @db.Decimal(12, 2)
  estimatedDurationHrs  Decimal  @db.Decimal(8, 2)
  computedAt            DateTime @default(now())
}

model BillOfLadingRecord {
  id              String               @id @default(uuid()) @db.Uuid
  orderId         String?              @db.Uuid
  order           Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceNumber   String
  vendorName      String
  rawFileUrl      String
  extractedJson   Json
  confidence      ExtractionConfidence
  reviewedByHuman Boolean              @default(false)
  createdAt       DateTime             @default(now())
}
